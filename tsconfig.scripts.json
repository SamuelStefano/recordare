{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    // Os scripts só importam tipos de `src/`, mas o TS ainda checa aqueles módulos — e eles leem
    // `import.meta.env`, que só existe com os tipos do Vite.
    "types": ["node", "vite/client", "vitest/globals"],
    "skipLibCheck": true,

    /* Rodam por tsx, que resolve import sem extensão como o bundler faz. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["scripts"]
}
